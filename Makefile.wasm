# Makefile.wasm — WebAssembly build (emscripten). Fully separate from the
# native build: `make` / `make run` / `make test` use the native Makefile;
# every wasm target goes through `make -f Makefile.wasm <target>`.
#
# What this builds:
#   .wasm-deps/                  isolated prefix: libobjc2 (GNUstep ObjC
#                                runtime) cross-built for wasm32-emscripten
#   wasm/MiniFoundation/         minimal Foundation shim (NSObject, NSString,
#                                NSMutableString, NSArray, NSLog) on libobjc2
#   vendor/raylib/build-web/     raylib compiled for PLATFORM=Web (OpenGL ES2)
#   wasm/build/                  output: demo.html/.js/.wasm + test binaries
#
# Targets:
#   make -f Makefile.wasm deps    cross-build libobjc2 + raylib (wasm/scripts/build-deps.sh)
#   make -f Makefile.wasm test    build + run the MiniFoundation test under node
#   make -f Makefile.wasm demo    build wasm/build/demo.html (the demo app)
#   make -f Makefile.wasm serve   serve wasm/build on http://localhost:8000
#   make -f Makefile.wasm clean   remove wasm/build objects and outputs
#
# Toolchain notes:
#   - ObjC is compiled with -fobjc-runtime=gnustep-2.0: that is the non-fragile
#     ABI libobjc2's WASM build supports (its build rejects OLDABI_COMPAT).
#   - The final link uses em++ (not emcc) because libobjc.a contains C++
#     objects and needs libc++/libc++abi.
#   - raylib's web backend drives a synchronous main loop via
#     emscripten_sleep(), so -sASYNCIFY is required; glfw comes from
#     emscripten's -sUSE_GLFW=3 port.

EMCC     ?= emcc
EMCXX    ?= em++
NODE     ?= node
PYTHON   ?= python3

WASM_DEPS   = .wasm-deps
RAYLIB_A    = vendor/raylib/build-web/raylib/libraylib.a
BUILD       = wasm/build
OBJDIR      = $(BUILD)/obj

# Must match libobjc2's wasm (v2, non-fragile) ABI.
# gnu11 (not strict c11): the wrapper uses strnlen, which musl hides under
# __STRICT_ANSI__; raylib itself compiles as gnu99.
OBJCFLAGS = -x objective-c -fno-objc-arc -fobjc-runtime=gnustep-2.0 \
            -std=gnu11 -O2 -MMD -MP
INCLUDES  = -Isrc -Ivendor/raygui/src -Ivendor/raylib/src \
            -I$(WASM_DEPS)/include -Iwasm/MiniFoundation

# raylib web: glfw port + asyncify (synchronous frame loop) + growable memory.
# The GravNav style is embedded into the .data pack and mounted at /gravnav.rgs;
# wasm/shell.html passes that path as argv[1], same as `make run` does natively.
EMLDFLAGS = -sUSE_GLFW=3 -sASYNCIFY -sALLOW_MEMORY_GROWTH=1 \
            --preload-file custom-styles/gravnav.rgs@/gravnav.rgs \
            --shell-file wasm/shell.html

SRC = src/RayguiImplementation.m src/RGGControls.m src/RGGContainers.m \
      src/RGGAdvanced.m src/RGGState.m \
      wasm/MiniFoundation/MiniFoundation.m
DEMO_SRC = examples/demo/main.m
TEST_SRC = wasm/tests/minifoundation_test.m

SRC_OBJ  = $(patsubst %.m,$(OBJDIR)/%.o,$(SRC))
DEMO_OBJ = $(OBJDIR)/examples/demo/main.o
TEST_OBJ = $(OBJDIR)/wasm/tests/minifoundation_test.o
MINIF_OBJ = $(OBJDIR)/wasm/MiniFoundation/MiniFoundation.o

DEMO_OUT = $(BUILD)/demo.html
TEST_OUT = $(BUILD)/minifoundation_test.js

LIBS = $(RAYLIB_A) -L$(WASM_DEPS)/lib -lobjc

.PHONY: all deps test demo run serve clean

all: demo

deps:
	sh wasm/scripts/build-deps.sh

# Compile: -x objective-c applies per-source; -MMD -MP writes header deps.
$(OBJDIR)/%.o: %.m
	@mkdir -p $(dir $@)
	$(EMCC) $(OBJCFLAGS) $(INCLUDES) -c $< -o $@

# Link with em++ (libobjc.a needs libc++). No -x here: archives are libraries.
$(DEMO_OUT): $(SRC_OBJ) $(DEMO_OBJ) $(RAYLIB_A) $(WASM_DEPS)/lib/libobjc.a wasm/shell.html
	$(EMCXX) $(SRC_OBJ) $(DEMO_OBJ) $(LIBS) $(EMLDFLAGS) -o $@

$(TEST_OUT): $(MINIF_OBJ) $(TEST_OBJ) $(WASM_DEPS)/lib/libobjc.a
	$(EMCXX) $(MINIF_OBJ) $(TEST_OBJ) -L$(WASM_DEPS)/lib -lobjc -o $@

test: $(TEST_OUT)
	$(NODE) $(TEST_OUT)

demo: $(DEMO_OUT)

# `run` mirrors the native Makefile's `make run`: build (if needed), then serve.
run: serve

serve: demo
	@echo "Serving $(BUILD) on http://localhost:8000/demo.html (Ctrl-C to stop)"
	cd $(BUILD) && $(PYTHON) -m http.server 8000

clean:
	rm -rf $(BUILD)

# Header dependencies (generated by -MMD -MP)
-include $(SRC_OBJ:.o=.d) $(DEMO_OBJ:.o=.d) $(TEST_OBJ:.o=.d)
