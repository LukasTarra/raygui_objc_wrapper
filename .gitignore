# Build output
build/
vendor/raylib/build/
*.o
*.d
*.a
*.so
*.dylib

# Demo and test binaries (the built executables, not the sources)
/examples/demo/demo
/demo
/tests/test_wrapper
/tests/smoke_test

# OS/editor noise
.DS_Store
*.swp
*~
# Emacs autosave and symlink lock files (a leading # in a pattern must be escaped)
\#*#
.#*

# ccls language-server index cache (created at project root on first run)
.ccls-cache/

# Submodule working-tree patches (applied by scripts/init-submodules.sh)
# The raygui submodule intentionally has a dirty working tree after init;
# `git status` noise is expected and harmless.
